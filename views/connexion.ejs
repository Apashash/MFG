<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Connexion - Market Flow Group</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <style>
        * { margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }
        html {
            scroll-behavior: smooth;
            -webkit-text-size-adjust: 100%;
        }
        html, body {
            min-height: 100vh;
            overflow-x: hidden;
            font-family: 'Poppins', sans-serif;
        }
        body {
            background: #fff;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
            -webkit-overflow-scrolling: touch;
        }
        .illustration {
            background: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 32px 24px 0;
            flex-shrink: 0;
        }
        .illustration img {
            width: 180px;
            height: 180px;
            object-fit: contain;
        }

        /* Form card */
        .form-card {
            background: #fff;
            flex-shrink: 0;
            padding: 16px 24px calc(40px + env(safe-area-inset-bottom, 0px));
        }

        .form-group { margin-bottom: 18px; }
        .form-label { display:block; font-size:13px; font-weight:600; color:#475569; margin-bottom:8px; }
        .input-wrap {
            display: flex; align-items: center;
            background: #F0F4FF;
            border: 1.5px solid #DBEAFE;
            border-radius: 14px;
            overflow: hidden;
            transition: border-color 0.2s, box-shadow 0.2s;
            position: relative;
        }
        .input-wrap input[type="password"],
        .input-wrap input[type="text"] {
            padding-right: 48px !important;
        }
        .eye-toggle {
            position: absolute; right: 0; top: 0; bottom: 0;
            background: none; border: none; cursor: pointer;
            color: #64748B; font-size: 16px;
            display: flex; align-items: center; justify-content: center;
            width: 44px; z-index: 2;
        }
        .input-wrap:focus-within {
            border-color: #2563EB;
            box-shadow: 0 0 0 3px rgba(37,99,235,0.15);
        }
        .input-icon {
            width: 46px; height: 46px;
            background: #0F2D4A;
            display: flex; align-items: center; justify-content: center;
            flex-shrink: 0;
            border-radius: 14px;
            margin: 5px;
        }
        .input-icon i { color: #fff; font-size: 17px; }
        .input-wrap input, .input-wrap select {
            flex: 1; border: none; background: transparent;
            padding: 14px 14px 14px 10px;
            font-size: 15px; color: #1E293B;
            font-family: 'Poppins', sans-serif;
            outline: none;
        }
        .input-wrap select { cursor: pointer; -webkit-appearance: none; }
        .input-wrap .phone-divider { width: 1px; height: 24px; background: #DBEAFE; flex-shrink: 0; }

        .error-box {
            background: #FFF0EE; border: 1px solid #F5A9A0; border-radius: 12px;
            padding: 13px 16px; margin-bottom: 20px; color: #C0392B; font-size: 13px;
            display: flex; align-items: center; gap: 10px;
        }
        .btn-submit {
            width: 100%; padding: 17px;
            background: linear-gradient(135deg, #1B3A8A, #0F2254);
            border: none; border-radius: 16px;
            font-size: 16px; font-weight: 700; color: #fff;
            cursor: pointer; margin-top: 10px;
            box-shadow: 0 6px 20px rgba(27,58,138,0.4);
            transition: transform 0.2s, box-shadow 0.2s;
            font-family: 'Poppins', sans-serif;
        }
        .btn-submit:hover { transform: translateY(-2px); box-shadow: 0 10px 28px rgba(27,58,138,0.5); }

        .divider { display:flex; align-items:center; gap:12px; margin: 24px 0; }
        .divider hr { flex:1; border:none; border-top: 1px solid #DBEAFE; }
        .divider span { color: #64748B; font-size: 13px; }

        .btn-register {
            width: 100%; padding: 15px;
            background: #F0FDF4; border: 1.5px solid #16A34A;
            border-radius: 16px; font-size: 15px; font-weight: 600;
            color: #16A34A; cursor: pointer; text-decoration: none;
            display: block; text-align: center; font-family: 'Poppins', sans-serif;
            transition: background 0.2s;
        }
        .btn-register:hover { background: #DCFCE7; }

        /* ── Top-left logo ── */
        .top-logo {
            padding: 12px 16px 0;
        }
        .top-logo img {
            height: 120px;
            width: auto;
            object-fit: contain;
        }

        /* ── Language switcher ── */
        .lang-wrap {
            position: fixed; top: 16px; right: 16px; z-index: 9999;
        }
        .lang-btn {
            display: flex; align-items: center; gap: 8px;
            background: #fff; border: 2px solid #1E293B;
            border-radius: 50px; padding: 8px 14px 8px 10px;
            cursor: pointer; font-family: 'Poppins', sans-serif;
            font-size: 14px; font-weight: 600; color: #1E293B;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
            transition: box-shadow 0.2s;
            white-space: nowrap;
        }
        .lang-btn:hover { box-shadow: 0 4px 14px rgba(0,0,0,0.14); }
        .lang-btn i.fa-globe { font-size: 20px; }
        .lang-btn i.fa-chevron-down { font-size: 12px; transition: transform 0.2s; }
        .lang-btn.open i.fa-chevron-down { transform: rotate(180deg); }
        .lang-dropdown {
            display: none; position: absolute; top: calc(100% + 8px); right: 0;
            background: #fff; border: 1.5px solid #E2E8F0; border-radius: 14px;
            box-shadow: 0 8px 24px rgba(0,0,0,0.12); overflow: hidden; min-width: 150px;
        }
        .lang-dropdown.open { display: block; }
        .lang-option {
            display: flex; align-items: center; gap: 10px;
            padding: 12px 16px; cursor: pointer; font-size: 14px;
            font-weight: 500; color: #1E293B; transition: background 0.15s;
        }
        .lang-option:hover { background: #F0F4FF; }
        .lang-option.active { color: #2563EB; font-weight: 700; }
        .lang-option .flag { font-size: 20px; }
    </style>
</head>
<body>

    <!-- Top-left Logo -->
    <div class="top-logo">
        <img src="/images/logo-mfg-nobg.png" alt="Market Flow Group">
    </div>

    <!-- Language Switcher -->
    <div class="lang-wrap">
        <button class="lang-btn" id="langBtn" onclick="toggleLangMenu()">
            <i class="fas fa-globe"></i>
            <span id="langLabel">Language</span>
            <i class="fas fa-chevron-down"></i>
        </button>
        <div class="lang-dropdown" id="langDropdown">
            <div class="lang-option" onclick="setLang('fr')">
                <span class="flag">🇫🇷</span> Français
            </div>
            <div class="lang-option" onclick="setLang('en')">
                <span class="flag">🇬🇧</span> English
            </div>
        </div>
    </div>

    <div class="illustration">
        <img src="/images/login-illustration.png" alt="Connexion">
    </div>

    <div class="form-card">

        <% if (error) { %>
            <div class="error-box"><i class="fas fa-exclamation-circle"></i> <%= error %></div>
        <% } %>

        <form action="/connexion" method="post" id="login-form">
            <div class="form-group">
                <label class="form-label">Numéro de Téléphone</label>
                <div class="input-wrap">
                    <div class="input-icon"><i class="fas fa-phone"></i></div>
                    <select id="indicatif" name="indicatif" required style="max-width:90px;">
                        <option value="">Code</option>
                        <% Object.entries(paysEligibles).forEach(([code, pays]) => { %>
                            <option value="<%= code %>" <%= (form_data.indicatif === code) ? 'selected' : '' %>><%= code %></option>
                        <% }) %>
                    </select>
                    <div class="phone-divider"></div>
                    <input type="tel" id="telephone" name="telephone" placeholder="Numéro de téléphone"
                           value="<%= form_data.telephone %>" required>
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Mot de passe</label>
                <div class="input-wrap">
                    <div class="input-icon"><i class="fas fa-lock"></i></div>
                    <input type="password" id="mot_de_passe" name="mot_de_passe" placeholder="Votre mot de passe" required>
                    <button type="button" class="eye-toggle" onclick="togglePwd('mot_de_passe',this)"><i class="fas fa-eye"></i></button>
                </div>
            </div>

            <button type="submit" class="btn-submit"><i class="fas fa-sign-in-alt"></i> Se Connecter</button>
        </form>

        <div class="divider"><hr><span>ou</span><hr></div>

        <a href="/inscription1" class="btn-register"><i class="fas fa-user-plus"></i> Créer un compte</a>
    </div>

    <script>
        const indicatifSelect = document.getElementById('indicatif');
        const isoToIndicatifMap = <%- JSON.stringify(isoMap) %>;

        // Auto-detect the user's country to preselect the phone prefix, without
        // overriding a value the user already picked (form re-render, or manual change).
        function detectFromLocale() {
            try {
                const locale = navigator.language || navigator.userLanguage;
                const parts = (locale || '').split('-');
                if (parts.length > 1) {
                    const cc = parts[parts.length - 1].toUpperCase();
                    if (cc.length === 2 && isoToIndicatifMap.hasOwnProperty(cc)) return cc;
                }
            } catch (e) {}
            return null;
        }
        async function detectCountry() {
            try {
                const controller = new AbortController();
                const timeout = setTimeout(() => controller.abort(), 2500);
                const resp = await fetch('https://ipapi.co/json/', { signal: controller.signal });
                clearTimeout(timeout);
                if (resp.ok) {
                    const data = await resp.json();
                    if (data && data.country_code && isoToIndicatifMap.hasOwnProperty(data.country_code)) {
                        return data.country_code;
                    }
                }
            } catch (e) {}
            return detectFromLocale();
        }
        const phpInd = '<%= form_data.indicatif %>';
        (async function() {
            if (phpInd || indicatifSelect.value) return;
            const cc = await detectCountry();
            if (cc && !indicatifSelect.value) {
                const ind = isoToIndicatifMap[cc];
                if (ind) indicatifSelect.value = ind;
            }
        })();
        function togglePwd(id, btn) {
            const inp = document.getElementById(id);
            if (inp.type === 'password') { inp.type = 'text'; btn.innerHTML = '<i class="fas fa-eye-slash"></i>'; }
            else { inp.type = 'password'; btn.innerHTML = '<i class="fas fa-eye"></i>'; }
        }

        // ── Language switcher ──
        const i18n = {
            fr: {
                langLabel: 'Langue',
                labelPhone: 'Numéro de Téléphone',
                placeholderPhone: 'Numéro de téléphone',
                labelPassword: 'Mot de passe',
                placeholderPassword: 'Votre mot de passe',
                btnLogin: '<i class="fas fa-sign-in-alt"></i> Se Connecter',
                dividerOr: 'ou',
                btnRegister: '<i class="fas fa-user-plus"></i> Créer un compte',
            },
            en: {
                langLabel: 'Language',
                labelPhone: 'Phone Number',
                placeholderPhone: 'Phone number',
                labelPassword: 'Password',
                placeholderPassword: 'Your password',
                btnLogin: '<i class="fas fa-sign-in-alt"></i> Log In',
                dividerOr: 'or',
                btnRegister: '<i class="fas fa-user-plus"></i> Create an account',
            }
        };

        function applyLang(lang) {
            const t = i18n[lang];
            document.getElementById('langLabel').textContent = t.langLabel;
            document.querySelector('label[for-id="phone"]') && null;
            // Labels
            const labels = document.querySelectorAll('.form-label');
            labels[0].textContent = t.labelPhone;
            labels[1].textContent = t.labelPassword;
            // Placeholders
            document.getElementById('telephone').placeholder = t.placeholderPhone;
            document.getElementById('mot_de_passe').placeholder = t.placeholderPassword;
            // Buttons
            document.querySelector('.btn-submit').innerHTML = t.btnLogin;
            document.querySelector('.divider span').textContent = t.dividerOr;
            document.querySelector('.btn-register').innerHTML = t.btnRegister;
            // Active option highlight
            document.querySelectorAll('.lang-option').forEach(el => el.classList.remove('active'));
            const opts = document.querySelectorAll('.lang-option');
            if (lang === 'fr') opts[0].classList.add('active');
            else opts[1].classList.add('active');
        }

        function setLang(lang) {
            localStorage.setItem('mfg_lang', lang);
            applyLang(lang);
            closeLangMenu();
        }

        function toggleLangMenu() {
            document.getElementById('langBtn').classList.toggle('open');
            document.getElementById('langDropdown').classList.toggle('open');
        }
        function closeLangMenu() {
            document.getElementById('langBtn').classList.remove('open');
            document.getElementById('langDropdown').classList.remove('open');
        }
        document.addEventListener('click', e => {
            if (!e.target.closest('.lang-wrap')) closeLangMenu();
        });

        // Apply saved language on load
        applyLang(localStorage.getItem('mfg_lang') || 'fr');
    </script>
</body>
</html>
