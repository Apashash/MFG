<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Accueil - Market Flow Group</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <style>
    :root {
        --primary: #3B82F6;
        --primary-dark: #1D4ED8;
        --accent: #F97316;
        --green: #10B981;
        --purple: #8B5CF6;
        --bg: #0B0F1A;
        --card: #131929;
        --text: #F1F5F9;
        --text-mid: #94A3B8;
        --text-muted: #64748B;
        --border: #1E2D4A;
        --shadow: 0 2px 12px rgba(0,0,0,0.3);
        --shadow-md: 0 4px 20px rgba(0,0,0,0.4);
    }
    * { margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }
    html, body { height:100%; overflow-x:hidden; }
    body {
        font-family: 'Poppins', sans-serif;
        background: var(--bg);
        color: var(--text);
        -webkit-text-size-adjust: 100%;
        touch-action: pan-y;
        user-select: none;
        -webkit-user-select: none;
    }
    .container { max-width: 430px; margin: 0 auto; padding-bottom: 90px; }

    /* ── HEADER ── */
    .header {
        background: var(--card);
        padding: 14px 18px;
        display: flex; align-items: center; gap: 12px;
        box-shadow: 0 1px 8px rgba(0,0,0,0.06);
        position: sticky; top: 0; z-index: 100;
    }
    .menu-btn {
        width: 38px; height: 38px; border-radius: 10px;
        background: var(--bg); border: none; cursor: pointer;
        display: flex; align-items: center; justify-content: center;
        color: var(--text); font-size: 18px; flex-shrink: 0;
    }
    .header-greeting { flex: 1; }
    .header-greeting .greet-top { font-size: 12px; color: var(--text-muted); font-weight: 400; }
    .header-greeting .greet-name { font-size: 17px; font-weight: 800; color: var(--text); line-height: 1.2; }
    .header-right { display: flex; align-items: center; gap: 10px; }
    .notif-wrap { position: relative; }
    .notif-btn {
        width: 38px; height: 38px; border-radius: 10px;
        background: var(--bg); border: none; cursor: pointer;
        display: flex; align-items: center; justify-content: center;
        color: var(--text); font-size: 18px;
    }
    .notif-badge {
        position: absolute; top: 4px; right: 4px;
        width: 16px; height: 16px; border-radius: 50%;
        background: #EF4444; color: #fff;
        font-size: 9px; font-weight: 700;
        display: flex; align-items: center; justify-content: center;
        border: 2px solid #fff;
    }
    .avatar-circle {
        width: 38px; height: 38px; border-radius: 50%;
        background: linear-gradient(135deg, #2563EB, #1D4ED8);
        display: flex; align-items: center; justify-content: center;
        color: #fff; font-size: 15px; font-weight: 800;
        overflow: hidden; flex-shrink: 0;
        border: 2px solid var(--border);
    }
    .avatar-circle img { width:100%; height:100%; object-fit:cover; }

    /* ── BALANCE CARD ── */
    .balance-section { padding: 16px 16px 0; }
    .balance-card {
        background: linear-gradient(135deg, #1D4ED8 0%, #2563EB 50%, #3B82F6 100%);
        border-radius: 22px;
        padding: 20px 18px 18px;
        display: flex; gap: 12px;
        box-shadow: 0 12px 32px rgba(37,99,235,0.38);
        position: relative; overflow: hidden;
    }
    .balance-card::before {
        content: '';
        position: absolute; top: -30px; right: -30px;
        width: 130px; height: 130px; border-radius: 50%;
        background: rgba(255,255,255,0.07);
    }
    .balance-card::after {
        content: '';
        position: absolute; bottom: -40px; left: 40%;
        width: 100px; height: 100px; border-radius: 50%;
        background: rgba(255,255,255,0.05);
    }
    .balance-left { flex: 1; min-width: 0; }
    .balance-label-top {
        color: rgba(255,255,255,0.75); font-size: 11px; font-weight: 600;
        letter-spacing: 0.5px; margin-bottom: 8px;
    }
    .balance-amount-row {
        display: flex; align-items: center; gap: 10px; margin-bottom: 14px;
    }
    .balance-amount {
        font-size: 24px; font-weight: 900; color: #fff; line-height: 1.1;
    }
    .eye-btn {
        background: none; border: none; cursor: pointer;
        color: rgba(255,255,255,0.7); font-size: 16px; padding: 2px;
    }
    .portefeuille-btn {
        display: inline-flex; align-items: center; gap: 6px;
        background: rgba(255,255,255,0.18); border: 1px solid rgba(255,255,255,0.35);
        border-radius: 20px; padding: 6px 13px;
        color: #fff; font-size: 11px; font-weight: 600;
        text-decoration: none; cursor: pointer;
        transition: background 0.2s;
    }
    .portefeuille-btn:hover { background: rgba(255,255,255,0.28); }
    .balance-right { display: flex; flex-direction: column; align-items: flex-end; justify-content: space-between; flex-shrink: 0; }
    .gains-label { color: rgba(255,255,255,0.7); font-size: 10px; font-weight: 600; letter-spacing: 0.3px; }
    .gains-amount { color: #4ADE80; font-size: 14px; font-weight: 800; margin-top: 3px; }
    .sparkline { display: block; margin-top: 8px; }

    /* ── ACTION BUTTONS ── */
    .actions-section { padding: 18px 16px 0; }
    .actions-grid {
        display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px;
    }
    .action-item {
        display: flex; flex-direction: column; align-items: center; gap: 7px;
        background: var(--card); border-radius: 16px;
        padding: 14px 6px; text-decoration: none;
        box-shadow: var(--shadow); border: 1px solid var(--border);
        cursor: pointer; transition: transform 0.18s, box-shadow 0.18s;
    }
    .action-item:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }
    .action-icon {
        width: 46px; height: 46px; border-radius: 14px;
        display: flex; align-items: center; justify-content: center;
        font-size: 20px; color: #fff; flex-shrink: 0;
    }
    .action-icon.blue   { background: linear-gradient(135deg, #2563EB, #1D4ED8); }
    .action-icon.green  { background: linear-gradient(135deg, #10B981, #059669); }
    .action-icon.orange { background: linear-gradient(135deg, #F97316, #EA580C); }
    .action-icon.purple { background: linear-gradient(135deg, #8B5CF6, #7C3AED); }
    .action-label {
        font-size: 10px; font-weight: 700; color: var(--text-mid);
        text-align: center; line-height: 1.3;
    }

    /* ── REFERRAL BANNER ── */
    .referral-section { padding: 18px 16px 0; }
    .referral-banner {
        background: linear-gradient(135deg, #1E293B 0%, #0F172A 100%);
        border-radius: 20px; padding: 20px 18px 20px 20px;
        display: flex; align-items: center; gap: 12px;
        box-shadow: 0 8px 24px rgba(15,23,42,0.22);
        overflow: hidden; position: relative;
    }
    .referral-banner::before {
        content: '';
        position: absolute; top: -20px; right: 30%;
        width: 80px; height: 80px; border-radius: 50%;
        background: rgba(37,99,235,0.15);
    }
    .referral-text { flex: 1; z-index: 1; }
    .referral-title {
        font-size: 16px; font-weight: 800; color: #fff; line-height: 1.3; margin-bottom: 6px;
    }
    .referral-title span { color: #60A5FA; }
    .referral-subtitle { font-size: 11px; color: rgba(255,255,255,0.6); margin-bottom: 14px; line-height: 1.4; }
    .referral-btn {
        display: inline-flex; align-items: center; gap: 7px;
        background: var(--primary); border: none; border-radius: 20px;
        padding: 9px 16px; color: #fff; font-size: 12px; font-weight: 700;
        cursor: pointer; font-family: 'Poppins', sans-serif;
        transition: background 0.2s;
    }
    .referral-btn:hover { background: var(--primary-dark); }
    .referral-img { flex-shrink: 0; font-size: 56px; z-index: 1; }

    /* ── SECTION TITLE ── */
    .section-head {
        display: flex; align-items: center; justify-content: space-between;
        padding: 20px 16px 10px;
    }
    .section-title { font-size: 16px; font-weight: 800; color: var(--text); }
    .section-link { font-size: 12px; font-weight: 600; color: var(--primary); text-decoration: none; display: flex; align-items: center; gap: 4px; }

    /* ── APERÇU STATS ── */
    .stats-section { padding: 0 16px; }
    .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
    .stat-card {
        background: var(--card); border-radius: 16px; padding: 12px 8px 10px;
        display: flex; flex-direction: column; align-items: center; gap: 4px;
        box-shadow: var(--shadow); border: 1px solid var(--border);
    }
    .stat-icon {
        width: 40px; height: 40px; border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
        font-size: 17px; color: #fff; margin-bottom: 2px;
    }
    .stat-icon.purple { background: linear-gradient(135deg, #8B5CF6, #7C3AED); }
    .stat-icon.green  { background: linear-gradient(135deg, #10B981, #059669); }
    .stat-icon.orange { background: linear-gradient(135deg, #F97316, #EA580C); }
    .stat-icon.blue   { background: linear-gradient(135deg, #2563EB, #1D4ED8); }
    .stat-value { font-size: 13px; font-weight: 800; color: var(--text); text-align: center; line-height: 1.2; }
    .stat-label { font-size: 9px; font-weight: 600; color: var(--text-muted); text-align: center; }
    .stat-sub { font-size: 8.5px; color: var(--text-muted); text-align: center; }

    /* ── ACTIVITIES ── */
    .activities-section { padding: 0 16px; }
    .activities-card {
        background: var(--card); border-radius: 18px;
        box-shadow: var(--shadow); border: 1px solid var(--border);
        overflow: hidden;
    }
    .activity-item {
        display: flex; align-items: center; gap: 12px;
        padding: 13px 14px; border-bottom: 1px solid var(--border);
    }
    .activity-item:last-child { border-bottom: none; }
    .activity-icon {
        width: 40px; height: 40px; border-radius: 12px; flex-shrink: 0;
        display: flex; align-items: center; justify-content: center;
        font-size: 16px; color: #fff;
    }
    .activity-icon.green  { background: linear-gradient(135deg, #10B981, #059669); }
    .activity-icon.blue   { background: linear-gradient(135deg, #2563EB, #1D4ED8); }
    .activity-icon.orange { background: linear-gradient(135deg, #F97316, #EA580C); }
    .activity-icon.purple { background: linear-gradient(135deg, #8B5CF6, #7C3AED); }
    .activity-body { flex: 1; min-width: 0; }
    .activity-title { font-size: 12px; font-weight: 700; color: var(--text); margin-bottom: 2px; }
    .activity-desc { font-size: 10px; color: var(--text-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .activity-right { text-align: right; flex-shrink: 0; }
    .activity-amount { font-size: 12px; font-weight: 800; color: #10B981; }
    .activity-time { font-size: 10px; color: var(--text-muted); margin-top: 2px; }
    .activity-empty {
        padding: 28px; text-align: center; color: var(--text-muted); font-size: 13px;
    }
    .activity-empty i { font-size: 32px; display: block; margin-bottom: 10px; color: var(--border); }

    /* ── NOTIFICATION BAR ── */
    .notif-bar-section { padding: 18px 16px 0; }
    .notif-bar {
        background: var(--card); border-radius: 14px; padding: 12px 14px;
        display: flex; align-items: center; gap: 10px;
        box-shadow: var(--shadow); border: 1px solid var(--border);
        overflow: hidden; height: 48px; position: relative;
    }
    .notif-bar-icon { color: var(--primary); font-size: 15px; flex-shrink: 0; }
    .notif-scroll { flex: 1; overflow: hidden; position: relative; height: 22px; }
    .notif-item {
        position: absolute; top: 0; left: 0; right: 0;
        font-size: 12px; font-weight: 500; color: var(--text-mid);
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
        opacity: 0; transition: opacity 0.5s;
    }
    .notif-item.visible { opacity: 1; }

    /* ── PLANS SECTION ── */
    .plans-section { padding: 0 16px 10px; }
    .plan-card {
        background: var(--card); border-radius: 18px; overflow: hidden;
        box-shadow: var(--shadow); border: 1px solid var(--border); margin-bottom: 12px;
    }
    .plan-img { height: 100px; background: #0F172A; position: relative; }
    .plan-img img { width:100%; height:100%; object-fit:cover; }
    .plan-badge {
        position: absolute; top: 8px; right: 8px;
        background: linear-gradient(135deg, #F97316, #EA580C);
        color: #fff; font-size: 10px; font-weight: 700;
        padding: 3px 10px; border-radius: 20px;
    }
    .plan-body { padding: 12px 14px; }
    .plan-name { font-size: 14px; font-weight: 700; color: var(--primary); margin-bottom: 8px; }
    .plan-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; background: var(--bg); border-radius: 10px; padding: 8px 10px; margin-bottom: 10px; }
    .plan-stat-val { font-size: 13px; font-weight: 800; color: var(--primary); }
    .plan-stat-lbl { font-size: 9px; color: var(--text-muted); margin-top: 1px; }
    .plan-price-row { display: flex; align-items: center; justify-content: space-between; border-top: 1px solid var(--border); padding-top: 8px; }
    .plan-price-lbl { font-size: 11px; color: var(--text-muted); }
    .plan-price-val { font-size: 14px; font-weight: 800; color: var(--text); }
    .plan-invest-btn {
        display: block; width: 100%;
        background: linear-gradient(135deg, #F97316, #EA580C);
        color: #fff; border: none; border-radius: 12px;
        padding: 10px; font-size: 13px; font-weight: 700;
        cursor: pointer; text-align: center;
        font-family: 'Poppins', sans-serif;
        margin-top: 10px; text-decoration: none;
    }
    .voir-plus-btn {
        display: flex; align-items: center; justify-content: center; gap: 8px;
        width: 100%; background: var(--bg);
        border: 2px solid var(--primary); border-radius: 14px;
        padding: 12px; font-size: 13px; font-weight: 700;
        color: var(--primary); text-decoration: none;
        box-shadow: var(--shadow); margin-bottom: 8px;
    }

    /* ── POPUP ── */
    .popup {
        display: none; position: fixed; inset: 0;
        background: rgba(0,0,0,0.5); backdrop-filter: blur(6px);
        z-index: 2000; align-items: center; justify-content: center; padding: 20px;
    }
    .popup-box {
        background: var(--card); border-radius: 22px; width: 100%; max-width: 370px;
        overflow: hidden; box-shadow: 0 24px 60px rgba(0,0,0,0.22);
    }
    .popup-header {
        background: linear-gradient(135deg, #2563EB, #1D4ED8);
        padding: 16px 18px;
        display: flex; justify-content: space-between; align-items: center;
    }
    .popup-header h3 { color: #fff; font-size: 16px; font-weight: 700; }
    .popup-close {
        background: rgba(255,255,255,0.2); border: none; color: #fff;
        width: 28px; height: 28px; border-radius: 50%; cursor: pointer;
        font-size: 16px; display: flex; align-items: center; justify-content: center;
    }
    .popup-body { padding: 18px; }
    .popup-text { color: var(--text-mid); font-size: 13px; line-height: 1.6; margin-bottom: 14px; }
    .comm-btn {
        display: flex; align-items: center; gap: 12px;
        padding: 13px 14px; border-radius: 12px; text-decoration: none;
        background: rgba(37,99,235,0.06); border: 1px solid rgba(37,99,235,0.2);
        margin-bottom: 8px; transition: all 0.2s;
    }
    .comm-btn:hover { background: rgba(37,99,235,0.12); }
    .comm-btn i { font-size: 22px; }
    .comm-btn-text h4 { color: var(--text); font-size: 13px; font-weight: 700; margin-bottom: 2px; }
    .comm-btn-text p { color: var(--text-muted); font-size: 11px; }

    /* ── POST POPUP ── */
    .form-group { margin-bottom: 14px; }
    .form-label { display: block; color: var(--text-muted); font-size: 11px; font-weight: 600; margin-bottom: 6px; }
    .form-textarea {
        width: 100%; background: var(--bg); border: 1.5px solid var(--border);
        border-radius: 12px; padding: 10px 12px; color: var(--text);
        font-size: 13px; font-family: 'Poppins', sans-serif; outline: none;
        min-height: 80px; resize: vertical;
    }
    .form-textarea:focus { border-color: var(--primary); }
    .file-upload { position: relative; }
    .file-upload-btn {
        background: var(--bg); border: 2px dashed var(--border);
        border-radius: 12px; padding: 18px; text-align: center;
        color: var(--text-muted); cursor: pointer; font-size: 12px;
    }
    .file-upload-input { position: absolute; inset: 0; opacity: 0; cursor: pointer; width:100%; height:100%; }
    .image-preview-small { max-width:100%; max-height:70px; border-radius:8px; margin-top:8px; display:none; }
    .submit-btn {
        width: 100%; background: linear-gradient(135deg, #F97316, #EA580C);
        color: #fff; border: none; border-radius: 12px; padding: 13px;
        font-size: 14px; font-weight: 700; cursor: pointer;
        font-family: 'Poppins', sans-serif;
    }

    /* ── WELCOME POPUP ── */
    .welcome-popup {
        position: fixed; inset: 0;
        background: rgba(0,0,0,0.6); backdrop-filter: blur(8px);
        z-index: 2500; display: flex; align-items: center; justify-content: center; padding: 20px;
    }
    .welcome-content {
        background: var(--card); border-radius: 22px; width: 100%; max-width: 360px;
        overflow: hidden; box-shadow: 0 30px 60px rgba(0,0,0,0.25);
        animation: popIn 0.4s cubic-bezier(0.175,0.885,0.32,1.275);
    }
    @keyframes popIn { from{transform:scale(0.9);opacity:0} to{transform:scale(1);opacity:1} }
    .welcome-header {
        background: linear-gradient(135deg, #2563EB, #1D4ED8);
        padding: 22px 18px; text-align: center; position: relative;
    }
    .welcome-header h3 { color:#fff; font-size:19px; font-weight:800; margin-bottom:6px; }
    .welcome-msg { font-size:12px; color:rgba(255,255,255,0.85); line-height:1.5; }
    .welcome-close-top {
        position:absolute; top:10px; right:12px;
        background:rgba(255,255,255,0.2); border:none; color:#fff;
        width:26px; height:26px; border-radius:50%; cursor:pointer;
        font-size:15px; display:flex; align-items:center; justify-content:center;
    }
    .welcome-body { padding:18px; }
    .welcome-btn {
        display:flex; align-items:center; justify-content:center; gap:8px;
        padding:12px; border-radius:12px; font-weight:700; cursor:pointer;
        text-decoration:none; font-size:13px; border:none;
        font-family:'Poppins',sans-serif; margin-bottom:8px; transition:transform 0.2s;
    }
    .welcome-btn:hover { transform:translateY(-2px); }
    .welcome-btn-join { background:linear-gradient(135deg,#F97316,#EA580C); color:#fff; }
    .welcome-btn-close { background:var(--bg); color:var(--text-mid); border:1.5px solid var(--border); }

    /* ── SHARE POPUP ── */
    .share-link-box {
        background: var(--bg); border: 1.5px solid var(--border); border-radius: 12px;
        padding: 12px 14px; display: flex; align-items: center; gap: 10px; margin-bottom: 12px;
    }
    .share-link-text {
        flex: 1; font-size: 12px; color: var(--text-mid);
        word-break: break-all; font-family: monospace;
    }
    .copy-btn {
        background: var(--primary); color: #fff; border: none;
        border-radius: 8px; padding: 6px 12px; font-size: 11px; font-weight: 700;
        cursor: pointer; font-family: 'Poppins', sans-serif; flex-shrink: 0;
    }
    .share-methods { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
    .share-method-btn {
        display: flex; align-items: center; gap: 8px;
        padding: 10px 12px; border-radius: 10px; border: 1.5px solid var(--border);
        background: var(--card); cursor: pointer;
        font-size: 12px; font-weight: 600; color: var(--text);
        font-family: 'Poppins', sans-serif; transition: background 0.2s;
    }
    .share-method-btn:hover { background: var(--bg); }
    </style>
</head>
<body class="page-index">
<%- include('partials/menu', { page: 'index' }) %>

<div class="container">

    <!-- ══ HEADER ══ -->
    <div class="header">
        <button class="menu-btn" onclick="openTelegramPopup()">
            <i class="fas fa-bars"></i>
        </button>
        <div class="header-greeting">
            <div class="greet-top">Bienvenue,</div>
            <div class="greet-name"><%= user.nom.split(' ')[0] %> 👋</div>
        </div>
        <div class="header-right">
            <div class="notif-wrap">
                <button class="notif-btn"><i class="fas fa-bell"></i></button>
                <div class="notif-badge">!</div>
            </div>
            <div class="avatar-circle">
                <%= user.nom.charAt(0).toUpperCase() %>
            </div>
        </div>
    </div>

    <!-- ══ BALANCE CARD ══ -->
    <div class="balance-section">
        <div class="balance-card">
            <div class="balance-left">
                <div class="balance-label-top">Solde disponible</div>
                <div class="balance-amount-row">
                    <div class="balance-amount" id="balanceDisplay"><%= parseFloat(user.solde || 0).toLocaleString('fr-FR') %> FCFA</div>
                    <button class="eye-btn" onclick="toggleBalance()" id="eyeBtn">
                        <i class="fas fa-eye" id="eyeIcon"></i>
                    </button>
                </div>
                <a href="/compte" class="portefeuille-btn">
                    Voir mon portefeuille <i class="fas fa-chevron-right" style="font-size:9px;"></i>
                </a>
            </div>
            <div class="balance-right">
                <div class="gains-label">Gains du jour</div>
                <div class="gains-amount">+ <%= parseFloat(revenus_jour || 0).toLocaleString('fr-FR') %> FCFA</div>
                <svg class="sparkline" width="80" height="40" viewBox="0 0 80 40">
                    <defs>
                        <linearGradient id="sparkGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                            <stop offset="0%" style="stop-color:#4ADE80;stop-opacity:0.3"/>
                            <stop offset="100%" style="stop-color:#4ADE80;stop-opacity:0"/>
                        </linearGradient>
                    </defs>
                    <path d="M0,38 C8,35 14,30 22,24 C30,18 36,28 44,18 C52,10 58,14 66,8 C72,4 76,6 80,2" 
                          fill="none" stroke="#4ADE80" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M0,38 C8,35 14,30 22,24 C30,18 36,28 44,18 C52,10 58,14 66,8 C72,4 76,6 80,2 L80,40 L0,40 Z" 
                          fill="url(#sparkGrad)"/>
                </svg>
            </div>
        </div>
    </div>

    <!-- ══ ACTION BUTTONS ══ -->
    <div class="actions-section">
        <div class="actions-grid">
            <a href="/investissement" class="action-item">
                <div class="action-icon blue"><i class="fas fa-wallet"></i></div>
                <span class="action-label">Investir</span>
            </a>
            <a href="/retrait" class="action-item">
                <div class="action-icon green"><i class="fas fa-arrow-circle-down"></i></div>
                <span class="action-label">Retirer</span>
            </a>
            <a href="#" class="action-item" onclick="openSharePopup();return false;">
                <div class="action-icon orange"><i class="fas fa-link"></i></div>
                <span class="action-label">Partager<br>mon lien</span>
            </a>
            <a href="/cadeau" class="action-item">
                <div class="action-icon purple"><i class="fas fa-gift"></i></div>
                <span class="action-label">Bonus<br>quotidien</span>
            </a>
        </div>
    </div>

    <!-- ══ REFERRAL BANNER ══ -->
    <div class="referral-section">
        <div class="referral-banner">
            <div class="referral-text">
                <div class="referral-title">Invitez vos amis et<br><span>gagnez plus !</span></div>
                <div class="referral-subtitle">Plus vous parrainez,<br>plus vous gagnez.</div>
                <button class="referral-btn" onclick="openSharePopup()">
                    <i class="fas fa-share-alt"></i> Partager maintenant
                </button>
            </div>
            <div class="referral-img">🎁</div>
        </div>
    </div>

    <!-- ══ NOTIFICATION BAR ══ -->
    <div class="notif-bar-section">
        <div class="notif-bar">
            <i class="fas fa-bell notif-bar-icon"></i>
            <div class="notif-scroll" id="notifContainer"></div>
        </div>
    </div>

    <!-- ══ APERÇU STATS ══ -->
    <div class="section-head">
        <div class="section-title">Aperçu</div>
        <a href="/equipe" class="section-link">Détails <i class="fas fa-chevron-right" style="font-size:10px;"></i></a>
    </div>
    <div class="stats-section">
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon purple"><i class="fas fa-user-friends"></i></div>
                <div class="stat-value"><%= filleuls_count %></div>
                <div class="stat-label">Filleuls</div>
                <div class="stat-sub">Total</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon green"><i class="fas fa-chart-line"></i></div>
                <div class="stat-value"><%= parseFloat(revenus_jour || 0).toLocaleString('fr-FR') %></div>
                <div class="stat-label">Aujourd'hui</div>
                <div class="stat-sub">FCFA</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon orange"><i class="fas fa-coins"></i></div>
                <div class="stat-value"><%= parseFloat(revenus && revenus.total ? revenus.total : 0).toLocaleString('fr-FR') %></div>
                <div class="stat-label">Rev. totaux</div>
                <div class="stat-sub">FCFA</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon blue"><i class="fas fa-star"></i></div>
                <div class="stat-value" style="font-size:11px;"><%= niveau_label %></div>
                <div class="stat-label">Niveau actuel</div>
                <div class="stat-sub">Niveau <%= niveau_num %></div>
            </div>
        </div>
    </div>

    <!-- ══ ACTIVITÉS RÉCENTES ══ -->
    <div class="section-head">
        <div class="section-title">Activités récentes</div>
        <a href="/historique" class="section-link">Voir tout <i class="fas fa-chevron-right" style="font-size:10px;"></i></a>
    </div>
    <div class="activities-section">
        <div class="activities-card">
            <% if (activites && activites.length > 0) { %>
                <% activites.forEach(function(act) {
                    let iconClass = 'blue';
                    let iconFa = 'fa-coins';
                    let titre = 'Transaction';
                    if (act.type === 'commission' || act.type === 'parrainage') { iconClass='green'; iconFa='fa-user-plus'; titre='Commission d\'affiliation'; }
                    else if (act.type === 'retrait') { iconClass='orange'; iconFa='fa-arrow-circle-up'; titre='Retrait effectué'; }
                    else if (act.type === 'investissement' || act.type === 'rendement') { iconClass='blue'; iconFa='fa-chart-line'; titre='Retour sur investissement'; }
                    else if (act.type === 'salaire') { iconClass='purple'; iconFa='fa-money-bill-wave'; titre='Salaire reçu'; }
                    else if (act.type === 'cadeau') { iconClass='orange'; iconFa='fa-gift'; titre='Bonus cadeau'; }
                    else if (act.type === 'depot') { iconClass='green'; iconFa='fa-arrow-circle-down'; titre='Dépôt reçu'; }
                    else { titre = act.type || 'Transaction'; }
                    const montant = parseFloat(act.montant || 0);
                    const desc = act.description || '';
                    const dateStr = act.date_creation ? new Date(act.date_creation).toLocaleDateString('fr-FR', { day:'2-digit', month:'short', hour:'2-digit', minute:'2-digit' }) : '';
                %>
                <div class="activity-item">
                    <div class="activity-icon <%= iconClass %>"><i class="fas <%= iconFa %>"></i></div>
                    <div class="activity-body">
                        <div class="activity-title"><%= titre %></div>
                        <div class="activity-desc"><%= desc || titre %></div>
                    </div>
                    <div class="activity-right">
                        <div class="activity-amount">+ <%= montant.toLocaleString('fr-FR') %> FCFA</div>
                        <div class="activity-time"><%= dateStr %></div>
                    </div>
                </div>
                <% }); %>
            <% } else { %>
                <div class="activity-empty">
                    <i class="fas fa-receipt"></i>
                    Aucune activité récente
                </div>
            <% } %>
        </div>
    </div>

    <!-- ══ PLANS SECTION ══ -->
    <div class="section-head">
        <div class="section-title"><i class="fas fa-crown" style="color:#F97316;margin-right:6px;font-size:14px;"></i>Plans VIP</div>
        <a href="/investissement" class="section-link">Voir tout <i class="fas fa-chevron-right" style="font-size:10px;"></i></a>
    </div>
    <div class="plans-section">
        <% if (typeof plans !== 'undefined' && plans && plans.length > 0) { %>
            <% plans.forEach(function(plan) {
                const prix   = parseFloat(plan.prix || 0);
                const taux   = parseFloat(plan.rendement_journalier || 0);
                const gain_j = Math.round(prix * taux / 100);
                const duree  = parseInt(plan.duree_jours || 0);
                const total  = gain_j * duree;
            %>
            <div class="plan-card">
                <div class="plan-img">
                    <img src="/images/altiora-logo-banner.jpeg" alt="<%= plan.nom %>"
                         onerror="this.src='/images/altiora-logo.png'">
                    <div class="plan-badge"><%= duree %> Jours</div>
                </div>
                <div class="plan-body">
                    <div class="plan-name"><%= plan.nom %></div>
                    <div class="plan-stats">
                        <div>
                            <div class="plan-stat-val"><%= gain_j.toLocaleString('fr-FR') %> FCFA</div>
                            <div class="plan-stat-lbl">Gain / jour</div>
                        </div>
                        <div>
                            <div class="plan-stat-val"><%= total.toLocaleString('fr-FR') %> FCFA</div>
                            <div class="plan-stat-lbl">Gain total</div>
                        </div>
                    </div>
                    <div class="plan-price-row">
                        <div>
                            <div class="plan-price-lbl">Investissement</div>
                            <div class="plan-price-val"><%= prix.toLocaleString('fr-FR') %> FCFA</div>
                        </div>
                    </div>
                    <a href="/investissement" class="plan-invest-btn">
                        <i class="fas fa-crown" style="margin-right:6px;"></i> Investir maintenant
                    </a>
                </div>
            </div>
            <% }); %>
        <% } %>
        <a href="/investissement" class="voir-plus-btn">
            <i class="fas fa-th-large"></i> Voir tous les plans
            <i class="fas fa-chevron-right" style="font-size:11px;"></i>
        </a>
    </div>

</div><!-- /container -->

<!-- ══ POPUP COMMUNAUTÉ ══ -->
<div class="popup" id="telegramPopup" style="display:none;">
    <div class="popup-box">
        <div class="popup-header">
            <h3>Rejoignez notre Communauté</h3>
            <button class="popup-close" onclick="closePopup('telegramPopup')">&times;</button>
        </div>
        <div class="popup-body">
            <p class="popup-text">Restez connecté et ne manquez aucune opportunité !</p>
            <% const _p = locals.appParams || {}; %>
            <% if (_p.telegram_link) { %>
            <a href="<%= _p.telegram_link %>" target="_blank" rel="noopener" class="comm-btn">
                <i class="fab fa-telegram" style="color:#2AABEE;font-size:22px;"></i>
                <div class="comm-btn-text">
                    <h4>Canal Telegram officiel</h4>
                    <p>Annonces et actualités</p>
                </div>
            </a>
            <% } %>
            <% if (_p.whatsapp_group_link) { %>
            <a href="<%= _p.whatsapp_group_link %>" target="_blank" rel="noopener" class="comm-btn">
                <i class="fab fa-whatsapp" style="color:#25D366;font-size:22px;"></i>
                <div class="comm-btn-text">
                    <h4>Groupe WhatsApp</h4>
                    <p>Échangez avec la communauté</p>
                </div>
            </a>
            <% } %>
            <% if (!_p.telegram_link && !_p.whatsapp_group_link) { %>
            <p style="text-align:center;color:var(--text-muted);font-size:13px;">Liens non configurés.</p>
            <% } %>
        </div>
    </div>
</div>

<!-- ══ POPUP PARTAGE ══ -->
<div class="popup" id="sharePopup" style="display:none;">
    <div class="popup-box">
        <div class="popup-header">
            <h3><i class="fas fa-share-alt" style="margin-right:8px;"></i>Partager mon lien</h3>
            <button class="popup-close" onclick="closePopup('sharePopup')">&times;</button>
        </div>
        <div class="popup-body">
            <p class="popup-text">Partagez votre lien de parrainage et gagnez des commissions sur chaque filleul !</p>
            <div class="share-link-box">
                <div class="share-link-text" id="referralLinkText">
                    <%= (typeof appParams !== 'undefined' && appParams && appParams.site_url ? appParams.site_url : '') %>/inscription1?ref=<%= user.code_parrainage || user.id %>
                </div>
                <button class="copy-btn" onclick="copyReferralLink()">Copier</button>
            </div>
            <div class="share-methods">
                <button class="share-method-btn" onclick="shareWhatsApp()">
                    <i class="fab fa-whatsapp" style="color:#25D366;font-size:18px;"></i> WhatsApp
                </button>
                <button class="share-method-btn" onclick="shareTelegram()">
                    <i class="fab fa-telegram" style="color:#2AABEE;font-size:18px;"></i> Telegram
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ══ POPUP POST ══ -->
<div class="popup" id="postPopup" style="display:none;">
    <div class="popup-box">
        <div class="popup-header">
            <h3>Créer un post</h3>
            <button class="popup-close" onclick="closePopup('postPopup')">&times;</button>
        </div>
        <div class="popup-body">
            <form id="postForm" enctype="multipart/form-data" method="POST" action="/">
                <div class="form-group">
                    <label class="form-label">Message</label>
                    <textarea name="message" class="form-textarea" placeholder="Partagez votre expérience avec MFG..." required></textarea>
                </div>
                <div class="form-group">
                    <label class="form-label">Image</label>
                    <div class="file-upload">
                        <div class="file-upload-btn">
                            <i class="fas fa-cloud-upload-alt" style="font-size:22px;margin-bottom:6px;display:block;color:var(--primary)"></i>
                            Cliquez pour ajouter une image
                            <img id="imgPreview" class="image-preview-small" alt="">
                        </div>
                        <input type="file" name="image" class="file-upload-input" accept="image/*" required onchange="previewImg(this)">
                    </div>
                </div>
                <button type="submit" class="submit-btn"><i class="fas fa-paper-plane"></i> Publier</button>
            </form>
        </div>
    </div>
</div>

<!-- ══ WELCOME POPUP ══ -->
<% const _pw = locals.appParams || {}; %>
<% if (_pw.popup_active === '1') { %>
<div class="welcome-popup" id="welcomePopup">
    <div class="welcome-content">
        <div class="welcome-header">
            <h3>Market Flow Group</h3>
            <div class="welcome-msg"><%= _pw.popup_message || 'Bienvenue sur Market Flow Group ! Investissez dans des projets à fort potentiel.' %></div>
            <button class="welcome-close-top" onclick="closePopup('welcomePopup')">&times;</button>
        </div>
        <div class="welcome-body">
            <% if (_pw.telegram_link) { %>
            <a href="<%= _pw.telegram_link %>" target="_blank" rel="noopener" class="welcome-btn welcome-btn-join">
                <i class="fab fa-telegram"></i> Canal Telegram
            </a>
            <% } %>
            <% if (_pw.whatsapp_group_link) { %>
            <a href="<%= _pw.whatsapp_group_link %>" target="_blank" rel="noopener" class="welcome-btn" style="background:#25D366;color:#fff;">
                <i class="fab fa-whatsapp"></i> Groupe WhatsApp
            </a>
            <% } %>
            <button class="welcome-btn welcome-btn-close" onclick="closePopup('welcomePopup')">
                <i class="fas fa-times"></i> Fermer
            </button>
        </div>
    </div>
</div>
<% } %>

<script>
// ── POPUP UTILS ──
function closePopup(id) {
    const el = document.getElementById(id);
    if (el) el.style.display = 'none';
}
function openTelegramPopup() { document.getElementById('telegramPopup').style.display = 'flex'; }
function openPostPopup()     { document.getElementById('postPopup').style.display = 'flex'; }
function openSharePopup()    { document.getElementById('sharePopup').style.display = 'flex'; }

// Close popup on outside click
document.querySelectorAll('.popup').forEach(function(p) {
    p.addEventListener('click', function(e) {
        if (e.target === p) closePopup(p.id);
    });
});

// ── BALANCE TOGGLE ──
let balanceHidden = false;
const realBalance = '<%= parseFloat(user.solde || 0).toLocaleString("fr-FR") %> FCFA';
function toggleBalance() {
    balanceHidden = !balanceHidden;
    document.getElementById('balanceDisplay').textContent = balanceHidden ? '●●●●● FCFA' : realBalance;
    document.getElementById('eyeIcon').className = balanceHidden ? 'fas fa-eye-slash' : 'fas fa-eye';
}

// ── SHARE ──
function copyReferralLink() {
    const txt = document.getElementById('referralLinkText').textContent.trim();
    navigator.clipboard.writeText(txt).then(function() {
        const btn = document.querySelector('.copy-btn');
        btn.textContent = '✓ Copié !';
        btn.style.background = '#10B981';
        setTimeout(function() { btn.textContent = 'Copier'; btn.style.background = ''; }, 2000);
    });
}
function shareWhatsApp() {
    const txt = document.getElementById('referralLinkText').textContent.trim();
    const msg = encodeURIComponent('Rejoignez Market Flow Group et commencez à investir ! ' + txt);
    window.open('https://wa.me/?text=' + msg, '_blank');
}
function shareTelegram() {
    const txt = document.getElementById('referralLinkText').textContent.trim();
    const msg = encodeURIComponent('Rejoignez Market Flow Group ! ' + txt);
    window.open('https://t.me/share/url?url=' + encodeURIComponent(txt) + '&text=' + msg, '_blank');
}

// ── NOTIFICATIONS ──
const notifications = <%- JSON.stringify(notifications || []) %>;
let notifIdx = 0;
function showNotif() {
    const c = document.getElementById('notifContainer');
    if (!c) return;
    c.innerHTML = '';
    const msgs = notifications.length > 0
        ? notifications.map(function(n) { return n.message || n; })
        : ['Bienvenue sur Market Flow Group ! 🎉'];
    const el = document.createElement('div');
    el.className = 'notif-item';
    el.textContent = msgs[notifIdx % msgs.length];
    c.appendChild(el);
    setTimeout(function() { el.classList.add('visible'); }, 50);
    notifIdx++;
}
showNotif();
setInterval(function() {
    const cur = document.querySelector('.notif-item.visible');
    if (cur) { cur.classList.remove('visible'); setTimeout(showNotif, 500); }
    else showNotif();
}, 3500);

// ── IMAGE PREVIEW ──
function previewImg(input) {
    if (input.files && input.files[0]) {
        const r = new FileReader();
        r.onload = function(e) {
            const p = document.getElementById('imgPreview');
            p.src = e.target.result; p.style.display = 'block';
        };
        r.readAsDataURL(input.files[0]);
    }
}

// ── DISABLE ZOOM ──
document.addEventListener('wheel', function(e) { if (e.ctrlKey) e.preventDefault(); }, { passive: false });
document.addEventListener('gesturestart', function(e) { e.preventDefault(); });
</script>
</body>
</html>
