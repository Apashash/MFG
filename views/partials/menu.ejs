<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<style>
    :root {
        --nav-bg: #0F1525;
        --nav-border: #1E2D4A;
        --nav-inactive: #4A5568;
        --nav-active: #3B82F6;
    }
    .bottom-nav {
        position: fixed;
        bottom: 0; left: 0; width: 100%;
        background: var(--nav-bg);
        border-top: 1px solid var(--nav-border);
        display: flex;
        justify-content: space-around;
        align-items: flex-end;
        padding: 8px 4px 18px;
        z-index: 9999;
        box-shadow: 0 -4px 20px rgba(0,0,0,0.4);
    }
    .nav-item {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
        color: var(--nav-inactive);
        text-decoration: none;
        font-family: 'Poppins', 'Inter', sans-serif;
        font-size: 10px;
        font-weight: 500;
        padding: 2px 0;
        transition: color 0.2s;
        cursor: pointer;
        border: none;
        background: none;
    }
    .nav-icon {
        width: 38px; height: 38px;
        border-radius: 12px;
        background: transparent;
        display: flex; align-items: center; justify-content: center;
        transition: background 0.2s;
    }
    .nav-item i { font-size: 19px; color: var(--nav-inactive); transition: color 0.2s; }
    .nav-item span { font-size: 10px; letter-spacing: 0.1px; line-height: 1; }

    .nav-item.active { color: var(--nav-active); font-weight: 700; }
    .nav-item.active .nav-icon { background: rgba(59,130,246,0.15); }
    .nav-item.active i { color: var(--nav-active); }

    /* Centre elevated button */
    .nav-center {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
        text-decoration: none;
        font-family: 'Poppins', 'Inter', sans-serif;
        font-size: 10px;
        font-weight: 500;
        color: var(--nav-inactive);
        padding: 2px 0;
        margin-top: -18px;
    }
    .nav-center-btn {
        width: 50px; height: 50px;
        border-radius: 16px;
        background: linear-gradient(135deg, #3B82F6, #1D4ED8);
        display: flex; align-items: center; justify-content: center;
        box-shadow: 0 6px 18px rgba(59,130,246,0.5);
        border: 3px solid #0B0F1A;
    }
    .nav-center-btn i { font-size: 20px; color: #fff; }
    .nav-center span { font-size: 10px; color: var(--nav-inactive); font-weight: 600; }
    .nav-center.active span { color: var(--nav-active); font-weight: 700; }
    .nav-center.active .nav-center-btn { box-shadow: 0 6px 22px rgba(59,130,246,0.7); }

    body { padding-bottom: 90px !important; }
</style>

<nav class="bottom-nav">
    <a href="/" class="nav-item <%= locals.page === 'index' ? 'active' : '' %>">
        <div class="nav-icon"><i class="fas fa-home"></i></div>
        <span>Accueil</span>
    </a>
    <a href="/investissement" class="nav-item <%= locals.page === 'investissement' ? 'active' : '' %>">
        <div class="nav-icon"><i class="fas fa-chart-bar"></i></div>
        <span>Investir</span>
    </a>
    <a href="/equipe" class="nav-center <%= locals.page === 'equipe' ? 'active' : '' %>">
        <div class="nav-center-btn"><i class="fas fa-user-friends"></i></div>
        <span>Parrainage</span>
    </a>
    <a href="/marketplace" class="nav-item <%= locals.page === 'marketplace' ? 'active' : '' %>">
        <div class="nav-icon"><i class="fas fa-store"></i></div>
        <span>Marketplace</span>
    </a>
    <a href="/compte" class="nav-item <%= locals.page === 'compte' ? 'active' : '' %>">
        <div class="nav-icon"><i class="fas fa-user-circle"></i></div>
        <span>Moi</span>
    </a>
</nav>

<% if (locals.appParams && appParams.whatsapp_link) { %>
<a href="<%= appParams.whatsapp_link %>" target="_blank" rel="noopener"
   style="position:fixed;bottom:100px;right:16px;width:48px;height:48px;border-radius:50%;
          background:#25D366;color:#fff;display:flex;align-items:center;justify-content:center;
          box-shadow:0 6px 18px rgba(37,211,102,0.5);z-index:9998;text-decoration:none;
          transition:transform 0.2s;" onmouseover="this.style.transform='scale(1.1)'" onmouseout="this.style.transform='scale(1)'">
  <i class="fab fa-whatsapp" style="font-size:22px;"></i>
</a>
<% } %>
